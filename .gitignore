docker-compose.override.yml
compose.override.yml

# Cisco / vrnetlab VM images - large and licensed, never commit
*.qcow2
*.vmdk
*.iso
*.bin

# Runtime output from the containers
*.log
*.leases
*.leases~
*.pid

# Editors
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
